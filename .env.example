# =======================================================
# DATABASE CONFIGURATION (Wajib untuk Docker Compose Dev)
# =======================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_dev_password_here
POSTGRES_DB=bn_database_dev
# Jika apps langsung menembak database postgres via Prisma/Drizzle (opsional):
# DATABASE_URL=postgresql://postgres:your_secure_dev_password_here@db:5432/bn_database_dev

# =======================================================
# SUPABASE CONFIGURATION
# =======================================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =======================================================
# MONOREPO APP URLS & PORTS
# =======================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SPMB_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Menegaskan internal port Next.js di dalam container Docker
PORT=3000 

# =======================================================
# SECURITY & ROLES
# =======================================================
# JWT_SECRET=make-your-jwt-sec-key
ADMIN_ROLES=superadmin,admin

# =======================================================
# DOCKER / ENVIRONMENT INFRASTRUCTURE
# =======================================================
NODE_ENV=development
# Solusi agar Hot Module Replacement (HMR) Next.js lancar di dalam Docker Windows/Linux
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true